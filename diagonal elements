#include <stdio.h>
int main() {
    int rowsize, colsize;
    printf("Enter row size: ");
    scanf("%d", &rowsize);
    printf("Enter column size: ");
    
    scanf("%d", &colsize);
    int arr[rowsize][colsize];
    for (int r = 0; r < rowsize; r++) {
        for (int c = 0; c < colsize; c++) {
            
            printf("Enter value in index[%d][%d]: ", r, c);
            scanf("%d", &arr[r][c]);
        }
    }
    int diagonal_limit = (rowsize < colsize) ? rowsize : colsize;
    printf("\nThe Diagonal elements are:\n");

    for (int i = 0; i < diagonal_limit; i++) {
        printf("%d ", arr[i][i]);
    }
    printf("\n");

    return 0;
}
